      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git stash:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git tag:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git restore:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ls:*)",
      "Bash(npm outdated:*)",
      "Bash(npm audit:*)",
      "Bash(npm view:*)",
      "Bash(npm ci:*)",
      "Bash(npm cache:*)",
      "Bash(npm init:*)",
      "Bash(npm version:*)",
      "Bash(npm pack:*)",
      "Bash(npm link:*)",
      "Bash(npm prune:*)",
      "Bash(npm rebuild:*)",
      "Bash(npm start:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm ls:*)",
      "Bash(pnpm outdated:*)",
      "Bash(pnpm audit:*)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm dlx:*)",
      "Bash(pnpm rebuild:*)",
      "Bash(pnpm cache:*)",
      "Bash(npx:*)",
      "Bash(pod install:*)",
      "Bash(pod update:*)",
      "Bash(pod outdated:*)",
      "Bash(pod search:*)",
      "Bash(pod spec:*)",
      "Bash(pod lib lint:*)",
      "Bash(pod repo:*)",
      "Bash(pod cache:*)",
      "Bash(xcodebuild:*)",
      "Bash(xcrun:*)",
      "Bash(swift:*)",
      "Bash(swiftc:*)",
      "Bash(/usr/libexec/PlistBuddy:*)",
      "Bash(otool:*)",
      "Bash(./android/gradlew:*)",
      "Bash(./gradlew:*)",
      "Bash(eas build:*)",
      "Bash(eas submit:*)",
      "Bash(eas update:*)",
      "Bash(eas device:*)",
      "Bash(eas credentials:*)",
      "Bash(eas whoami:*)",
      "Bash(eas login:*)",
      "Bash(eas init:*)",
      "Bash(eas channel:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh repo view:*)",
      "Bash(gh repo clone:*)",
      "Bash(gh repo list:*)",
      "Bash(gh auth:*)",
      "Bash(gh api:*)",
      "Bash(gh run:*)",
      "Bash(gh workflow:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release create:*)",
      "Bash(gh release download:*)",
      "Bash(gh status:*)",
      "Bash(gh search:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(tee:*)",
      "Bash(test:*)",
      "Bash(mkdir:*)",
      "Bash(brew list:*)",
      "Bash(brew info:*)",
      "Bash(brew search:*)",
      "Bash(rm -f .git/index.lock:*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr *)",
      "Bash(make build:*)",
      "Bash(make test*)",
      "Bash(make test-*)",
      "Bash(git reset:*)",
      "Bash(GIT_EDITOR=true git rebase:*)",
      "Bash(pkill:*)",
      "Bash(git apply:*)",
      "Bash(gtimeout 60 west build:*)",
      "Bash(cc -fsyntax-only:*)",
      "Bash(codex:*)",
      "Bash(xargs:*)",
      "Bash(echo:*)",
      "Bash(rg:*)",
      "Bash(git:*)",
      "Bash(docker compose:*)",
      "Bash(python3:*)",
      "Bash(unzip:*)",
      "Bash(zip:*)",
      "Bash(xxd:*)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\"",
    "padding": 0
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "codex@openai-codex": true,
    "commit-commands@claude-code-plugins": true,
    "skill-creator@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "language": "お調子ものタメ口の日本語、一人称は僕",
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "teammateMode": "in-process",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": false,
  "mcpServers": {}
}
